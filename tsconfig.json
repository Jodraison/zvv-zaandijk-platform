{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-admin20-build/types/**/*.ts",
    ".next-admin20c-build/types/**/*.ts",
    ".next-c006-build/types/**/*.ts",
    ".next-c007-build/types/**/*.ts",
    ".next-c008-build/types/**/*.ts",
    ".next-c009-build/types/**/*.ts",
    ".next-c010-build/types/**/*.ts",
    ".next-d001-build/types/**/*.ts",
    ".next-d002-build/types/**/*.ts",
    ".next-fcc2-build/types/**/*.ts",
    ".next-fo-final-build/types/**/*.ts",
    ".next-fo-final-build2/types/**/*.ts",
    ".next-fo-preview/types/**/*.ts",
    ".next-ops-build/types/**/*.ts",
    ".next-ops-preview/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-rw-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
