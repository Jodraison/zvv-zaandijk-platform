# Copy to .env.local (recommended) or .env. Next.js loads .env then .env.local.
# Never commit .env / .env.local with real keys.

# Supabase (required — see supabase/migrations/)
NEXT_PUBLIC_SUPABASE_URL=your-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-key

# Server only: storage uploads, seeds. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-secret

# Optional: verbose server auth logging (readDb, middleware)
# SUPABASE_DEBUG_AUTH=1

# Maintenance mode (server-only — never NEXT_PUBLIC_). Redirects public visitors to /maintenance.
MAINTENANCE_MODE=false
# When MAINTENANCE_MODE=true: logged-in admin may still browse public routes (preview).
MAINTENANCE_ADMIN_BYPASS=false

# Public Football Academy at `/academie` (Decision Lab + learn paths). Server-only.
# Default OFF (unset/false/invalid → hidden). Set true to re-enable public nav + routes.
# Distinct from ACADEMY_ENABLED (MVP mount `/academy`) and ACADEMY_OFFLINE (MVP banner).
ACADEMY_PUBLIC_VISIBLE=false
# Optional MVP mount at `/academy` (auth-gated when enabled). Default OFF.
# ACADEMY_ENABLED=false
# Optional MVP offline banner demo flag.
# ACADEMY_OFFLINE=false

# Local-only Admin 2.0 UI review gallery at /review/admin-ui (screenshots). Never set in production.
# ADMIN_UI_PREVIEW=1

# Optional: migrate:club-atomic — direct Postgres (port 5432)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
